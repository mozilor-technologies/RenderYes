{
  "name": "@renderyes/generate",
  "version": "0.1.1",
  "description": "Dev-time CLI that has an LLM draft a bespoke, host-styled component from the approved data contract, verifies it mechanically, and emits a reviewable diff.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozilor-technologies/RenderYes.git",
    "directory": "packages/generate"
  },
  "homepage": "https://github.com/mozilor-technologies/RenderYes#readme",
  "bugs": {
    "url": "https://github.com/mozilor-technologies/RenderYes/issues"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "renderyes-generate": "./bin/generate.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured yet)\""
  },
  "dependencies": {
    "@renderyes/capability-catalog": "workspace:*",
    "@renderyes/react": "workspace:*",
    "@renderyes/server": "workspace:*",
    "@renderyes/site-sdk": "workspace:*",
    "esbuild": "^0.28.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2"
  }
}
