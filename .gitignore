node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
.env.*
!.env.example
coverage/
.DS_Store

# Editor and agent scratch directories. None are project configuration; a
# contributor who wants to commit one should remove its line deliberately.
.claude/
.codex/
.cursor/
.gemini/
.agents/
.pnpm-store/

# Eval run outputs — regenerated by `pnpm --filter @renderyes/planner-eval eval`.
# The committed case corpus lives under eval/cases/ deliberately;
# these are the transient per-run artifacts.
eval-failures.json
eval-baseline.json

# Generated at pack time by packages/server/scripts/copy-host-docs.mjs, which copies
# the host guides in so a registry consumer receives them. Never edit here.
packages/*/docs/

# Generated at build time from the Zod definitions (scripts/emit-json-schemas.mjs).
# Committing them is how they drift.
packages/capability-catalog/schemas/

# Packed tarballs from `pnpm sync:local` and `pnpm smoke:install` — build
# output consumed by apps outside the workspace. Regenerated on demand.
dist-packages/

# Stray run logs.
*.log

# Documentation site: build output and Docusaurus's own cache. The site's
# pnpm-lock.yaml IS committed — the Pages workflow installs with
# --frozen-lockfile.
website/build/
website/.docusaurus/
