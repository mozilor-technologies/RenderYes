{
  "name": "@renderyes/catalog-review",
  "version": "0.1.1",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured yet)\"",
    "test": "node --test test/*.test.mjs",
    "start": "node serve.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozilor-technologies/RenderYes.git",
    "directory": "apps/catalog-review"
  },
  "homepage": "https://github.com/mozilor-technologies/RenderYes#readme",
  "bugs": {
    "url": "https://github.com/mozilor-technologies/RenderYes/issues"
  },
  "devDependencies": {
    "@renderyes/capability-catalog": "workspace:*",
    "@renderyes/site-sdk": "workspace:*",
    "@renderyes/starter-catalog": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "description": "Local review UI for approving a host's data into a RenderYes capability catalog.",
  "bin": {
    "renderyes-catalog-review": "./serve.mjs"
  },
  "files": [
    "dist",
    "serve.mjs",
    "README.md"
  ]
