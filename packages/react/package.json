{
  "name": "@renderyes/react",
  "version": "0.1.0",
  "description": "The single package a host frontend installs: provider, launcher, isolated surface, and host-component registration.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozilor-technologies/RenderYes.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/mozilor-technologies/RenderYes#readme",
  "bugs": {
    "url": "https://github.com/mozilor-technologies/RenderYes/issues"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ingest-fs": {
      "types": "./dist/ingest-fs.d.ts",
      "import": "./dist/ingest-fs.js",
      "default": "./dist/ingest-fs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured yet)\"",
    "prepack": "node ../server/scripts/copy-host-docs.mjs react"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@a2ui/react": ">=0.10.2 <0.11.0",
    "@a2ui/web_core": ">=0.10.5 <0.11.0",
    "@renderyes/core": "workspace:*",
    "@renderyes/site-sdk": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
